{
  "name": "ddo-roadmap-xp",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && npx wrangler@3 pages dev public",
    "db:init": "npx wrangler@3 d1 execute ddo-roadmap --remote --file=schema.sql",
    "db:init:local": "npx wrangler@3 d1 execute ddo-roadmap --local --file=schema.sql",
    "deploy": "node build.mjs && npx wrangler@3 pages deploy public --project-name ddo-roadmap-xp",
    "lighthouse": "node scripts/lh.mjs"
  },
  "devDependencies": {
    "lighthouse": "^13.6.0",
    "marked": "^12.0.2",
    "playwright": "1.64.1"
  }
}
